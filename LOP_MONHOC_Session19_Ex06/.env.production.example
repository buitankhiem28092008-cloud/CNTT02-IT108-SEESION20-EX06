# PROD: KHÔNG bao giờ tạo file .env thật trong repo/máy dev.
# Giá trị thật nằm trong Secret Manager (AWS Secrets Manager / Vault / GitHub Environments)
# và được inject lúc deploy. File này chỉ liệt kê TÊN biến bắt buộc.
APP_ENV=production
APP_PORT=8080
APP_URL=https://<your-domain>
DEBUG=false
LOG_LEVEL=error

DB_HOST=<from-secret-manager>
DB_PORT=5432
DB_NAME=<from-secret-manager>
DB_USER=<from-secret-manager>
DB_PASSWORD=<from-secret-manager>

JWT_SECRET=<from-secret-manager>
PAYMENT_API_KEY=<live-key-from-secret-manager>
EMAIL_API_KEY=<from-secret-manager>
