# Template chung - COPY thành .env rồi điền giá trị thật. KHÔNG commit .env
# Xem thêm: .env.development.example | .env.test.example | .env.production.example
APP_ENV=development          # development | test | production
APP_PORT=3000
APP_URL=http://localhost:3000

# --- Database ---
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Secrets ứng dụng ---
JWT_SECRET=                  # >= 32 ký tự ngẫu nhiên: openssl rand -hex 32
SESSION_SECRET=

# --- Dịch vụ bên thứ ba ---
PAYMENT_API_KEY=
EMAIL_API_KEY=
