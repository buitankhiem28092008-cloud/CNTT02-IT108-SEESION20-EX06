# DEV: máy lập trình viên. Dùng key SANDBOX, DB local, dữ liệu giả.
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
DEBUG=true
LOG_LEVEL=debug

DB_HOST=localhost
DB_PORT=5432
DB_NAME=shop_dev
DB_USER=dev_user
DB_PASSWORD=<your-local-password>

JWT_SECRET=<generate-with-openssl-rand-hex-32>
PAYMENT_API_KEY=<sandbox-key-from-provider-dashboard>
EMAIL_API_KEY=<sandbox-key>
